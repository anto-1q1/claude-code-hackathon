# Copy this file to terraform.tfvars and fill in values.
# terraform.tfvars is git-ignored — never commit real values.

aws_region  = "eu-west-1"
environment = "prod"
vpc_cidr    = "10.0.0.0/16"
db_username = "contoso_app"

# DB password is NOT a variable here — it is generated by random_password
# in the secrets module and stored directly in Secrets Manager.
# No password ever appears in .tfvars or state in plaintext.
